{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "default_locale": "en",
  "version": "1.0.3",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["localization.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/shigang-16.png",
    "32": "icons/shigang-32.png",
    "48": "icons/shigang-48.png",
    "128": "icons/shigang-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/shigang-16.png",
      "32": "icons/shigang-32.png",
      "48": "icons/shigang-48.png",
      "128": "icons/shigang-128.png"
    }
  }
} 
